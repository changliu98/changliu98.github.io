<footer class="site-footer" role="contentinfo">
  <div class="container">
    <span>
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}.
      {%- if site.footer_text %} {{ site.footer_text }}{% endif %}
      {%- if site.impressum_path %} <a href="{{ site.impressum_path | relative_url }}">Impressum</a>.{% endif %}
    </span>
    {% if site.last_updated %}
      <span>Last updated {{ 'now' | date: '%B %-d, %Y' }}.</span>
    {% endif %}
  </div>
</footer>
