<header class="site-header">
  <div class="container">
    <a class="brand" href="{{ '/' | relative_url }}">
      {{- site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name -}}
    </a>
    {% if site.homepage_nav_links %}
      <nav class="site-nav" aria-label="Site">
        {% for p in site.homepage_nav_links %}
          <a href="{{ p.link | relative_url }}"{% if p.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ p.title }}</a>
        {% endfor %}
        {% if site.enable_darkmode %}
          <button id="light-toggle" class="theme-toggle" title="Change theme" aria-label="Change theme">
            <i class="ti ti-sun-moon" id="light-toggle-system"></i>
            <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
            <i class="ti ti-sun-filled" id="light-toggle-light"></i>
          </button>
        {% endif %}
      </nav>
    {% endif %}
  </div>
</header>
